# Copy to .env. The sandbox platform variables are required; the rest are
# optional with development fallbacks the server warns about at startup.

ADDR=:8080

# NeevCloud sandbox platform (required).
NEEV_API_KEY=
NEEV_ORG_ID=
NEEV_PROJECT_ID=
NEEV_API_BASE=https://api.ai.neevcloud.com/agent
NEEV_REGION=

# Postgres. Unset -> in-memory store (builds and sessions lost on restart).
DATABASE_URL=postgres://trylive:trylive@localhost:5432/trylive?sslmode=disable

# Model used when no detector recognises a repo, and to repair failed installs.
# Any OpenAI-compatible chat endpoint. Unset -> such repos are unsupported.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-5-2

# GitHub token (read-only public access is enough); raises the lookup rate
# limit from 60/hour to 5000/hour.
GITHUB_TOKEN=

# Capacity.
BUILD_CONCURRENCY=5
MAX_LIVE_SESSIONS=200
MAX_SESSIONS_PER_IP=2
